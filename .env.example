# Copy to .env; never commit real endpoints, credentials or data.
EVONEXT_DEMO=false
EVONEXT_API_KEY=
# Existing infrastructure; use an isolated collection and bucket during acceptance.
EVONEXT_MONGO_URI=mongodb://127.0.0.1:27017
EVONEXT_MONGO_DATABASE=evonext
EVONEXT_MONGO_COLLECTION=evonext_snapshots
EVONEXT_MINIO_ENDPOINT=127.0.0.1:9000
EVONEXT_MINIO_ACCESS_KEY=
EVONEXT_MINIO_SECRET_KEY=
EVONEXT_MINIO_BUCKET=evonext
EVONEXT_MINIO_SECURE=false
EVONEXT_POSTGRES_DSN=postgresql+psycopg://evonext:CHANGE_ME@127.0.0.1:5432/evonext
EVONEXT_BROKER_URL=redis://127.0.0.1:6379/0
# Optional trusted local EvoLoop dotenv reference. No old secrets are copied into this file.
# When configured, the workbench defaults to the read-only old Mongo task list.
EVONEXT_LEGACY_ENV_FILE=
# The bridge is opt-in. It never writes legacy Mongo collections directly.
EVONEXT_LEGACY_BASE_URL=
EVONEXT_LEGACY_API_KEY=
EVONEXT_LEGACY_WRITES=false
# Langfuse SDK v4: verify your server compatibility before enabling.
EVONEXT_LANGFUSE_ENABLED=false
EVONEXT_LANGFUSE_BASE_URL=
EVONEXT_LANGFUSE_PUBLIC_KEY=
EVONEXT_LANGFUSE_SECRET_KEY=
EVONEXT_TRACE_CONTENT=false
# No model call is made by startup, import, browsing or tests.
EVONEXT_MODEL_BASE_URL=
EVONEXT_MODEL_API_KEY=
EVONEXT_MODEL_NAME=

# Paid requests require both this switch and a PostgreSQL receipt store.
EVONEXT_MODEL_CALLS_ENABLED=false
# Use one stable account/workspace scope across workers; not supplied by model/user payloads.
EVONEXT_MODEL_BUDGET_SCOPE=default
EVONEXT_MODEL_CALLS_PER_MINUTE=10
EVONEXT_MODEL_CALLS_PER_HOUR=100
EVONEXT_MODEL_CALLS_PER_DAY=500

# Operator identity is server-owned. Shared API keys are not proof of a named human reviewer.
# Without a configured operator, production Case decisions are disabled.
EVONEXT_REVIEW_OPERATOR_ID=
# Opt-in local candidate library. API and worker must share this absolute path on one host.
# This FileLock-backed library is not distributed production storage.
EVONEXT_WORKSHOP_ROOT=
EVONEXT_WORKSHOP_OWNER=
